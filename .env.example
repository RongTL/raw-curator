# raw-curator — tuned for AMD Ryzen 3 3100 (4C/8T), 24 GB RAM, RTX 2060 6 GB.
# Copy to `.env`; compose injects these into both containers via env_file.
# Every key here maps to a field in app/config.py; unknown keys are ignored.
# Commented lines document a knob at its code default; active lines are the
# recommended settings for this hardware.

# CPU: process pools default to all logical cores (8). Override only to throttle.
# (also caps torch CPU threads in the score/enhance stages).
#RAWCURATOR_CPU_WORKERS=8

# Ingest preview/thumb sizes (long edge in px) + their JPEG quality.
RAWCURATOR_PREVIEW_LONG_EDGE=3000
RAWCURATOR_THUMB_LONG_EDGE=512
#RAWCURATOR_JPEG_QUALITY_PREVIEW=92
#RAWCURATOR_JPEG_QUALITY_THUMB=88

# GPU batch size for 6 GB VRAM. Lower to 4 on CUDA OOM during scoring.
# (MUSIQ/MANIQA run one image at a time by design — no batch knob.)
RAWCURATOR_CLIP_BATCH=8

# darktable develop workflow; `scene-referred (sigmoid)` is the default look.
#RAWCURATOR_DARKTABLE_WORKFLOW=scene-referred (sigmoid)
# Per-frame lens distortion + CA correction via lensfun (read from EXIF).
# No-op for lenses lensfun can't resolve; set false to skip it.
RAWCURATOR_ENHANCE_LENS_CORRECTION=true

# Enhancement VRAM/disk knobs. AI_SCALE 1.0 = native pixels; drop to 0.85/0.7 on OOM.
RAWCURATOR_ENHANCE_AI_SCALE=1.0
# Output size. `native` = no upscale (~4x smaller TIFFs). Real-ESRGAN's x2
# upscale is PLANNED ONLY when the target enlarges the source (e.g. `200%`)
# or the source long edge is below SR_MIN_LONG_EDGE — so at `native` a normal
# 24 MP source gets NO super-resolution. Use `200%` for ~12k x 8k 16-bit
# TIFFs (much larger on disk) if you want SR detail recovery.
RAWCURATOR_ENHANCE_TARGET_RES=native
#RAWCURATOR_ENHANCE_SR_MIN_LONG_EDGE=3000
RAWCURATOR_ENHANCE_DENOISE=true
# 1.0 = full SCUNet (smoothest). <1 keeps a fraction of original
# micro-texture so the photo doesn't look plastic.
RAWCURATOR_ENHANCE_DENOISE_STRENGTH=0.75
# 1.0 = full Real-ESRGAN (sharpest, most AI-looking). ~0.7 keeps most
# detail recovery while softening the GAN's over-sharpening on natural
# textures; drop to 0.5 for very soft "film-like" output.
RAWCURATOR_ENHANCE_REALESRGAN_FIDELITY=0.7
RAWCURATOR_ENHANCE_FACE_RESTORE=true
# CodeFormer w: higher = more faithful to original skin (natural),
# lower = stronger restoration (waxy/airbrushed risk).
RAWCURATOR_ENHANCE_CODEFORMER_W=0.85
# Faces at least this many px on the long side and sharp are left alone;
# smaller or soft faces get CodeFormer.
#RAWCURATOR_ENHANCE_FACE_RESTORE_MAX_PX=300
# ArcFace cosine between a face before and after CodeFormer; below this the
# original face is pasted back (identity guard).
#RAWCURATOR_ENHANCE_FACE_MIN_SIMILARITY=0.5
# Backlit recovery: auto-detected via histogram; lifts subject shadows
# while protecting background highlights. Disable if your darktable
# XMPs already handle tone mapping.
RAWCURATOR_ENHANCE_BACKLIT_RECOVERY=true
RAWCURATOR_ENHANCE_BACKLIT_SHADOW_LIFT=0.4
RAWCURATOR_ENHANCE_BACKLIT_HIGHLIGHT_PROTECT=0.15
# VRAM-fit knobs for the AI steps. Lower SCUNET_TILE (multiples of 64) or
# CODEFORMER_MAX_LONG_EDGE if SCUNet / CodeFormer OOM on your card.
#RAWCURATOR_SCUNET_TILE=512
#RAWCURATOR_SCUNET_TILE_PAD=32
#RAWCURATOR_CODEFORMER_MAX_LONG_EDGE=2048

# Clustering: EXIF timestamp window (seconds) for burst grouping.
# (Clustering otherwise uses CLIP HDBSCAN; there are no pHash/cosine knobs.)
RAWCURATOR_BURST_SECONDS=2

# JPEG export
RAWCURATOR_JPEG_QUALITY=92
# Cap long edge for sharing; 0 = native.
#RAWCURATOR_JPEG_LONG_EDGE=4000
RAWCURATOR_JPEG_PROGRESSIVE=true
RAWCURATOR_JPEG_SUBDIR=jpeg

# Monitoring
#RAWCURATOR_MONITOR_DISK_WARN_FREE_GB=50

# Logging level for every raw-curator process (stage logs in the UI show these lines).
#RAWCURATOR_LOG_LEVEL=INFO
